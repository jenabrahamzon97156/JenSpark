# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings -> API in the Supabase dashboard.
#
# .env.local is already gitignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Food search (Food Tracking tab). Free, no credit card — sign up at
# https://api.data.gov/signup/ and the key arrives by email in seconds.
NEXT_PUBLIC_USDA_API_KEY=your-usda-fooddata-central-api-key

# Second food search source. Free tier confirmed at api-ninjas.com (no
# credit card, free for personal/non-commercial use) — sign up at
# https://api-ninjas.com/register and your key is on your dashboard.
NEXT_PUBLIC_API_NINJAS_KEY=your-api-ninjas-key
