# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings -> API in the Supabase dashboard.
#
# .env.local is already gitignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Food search (Food Tracking tab). Free, no credit card — sign up at
# https://api.data.gov/signup/ and the key arrives by email in seconds.
NEXT_PUBLIC_USDA_API_KEY=your-usda-fooddata-central-api-key

# Second food search source — better for natural US serving sizes (e.g.
# "1 large egg" instead of grams). Free developer account at
# https://developer.nutritionix.com/signup — gives you both values below.
NEXT_PUBLIC_NUTRITIONIX_APP_ID=your-nutritionix-app-id
NEXT_PUBLIC_NUTRITIONIX_APP_KEY=your-nutritionix-app-key
